[Unit]
Description=DuoShot %i maintenance
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
# Resolve the web container by its compose service label (names change when Coolify recreates
# the project) and refuse to guess when zero or several containers match. $$ is a literal $.
ExecStart=/bin/sh -c 'set -- $$(docker ps -q --filter label=com.docker.compose.service=web); [ $$# -eq 1 ] || { echo "expected one running web container, found $$#" >&2; exit 1; }; exec docker exec "$$1" node scripts/run-maintenance.mjs %i'
TimeoutStartSec=75
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
