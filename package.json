{
  "name": "duoshot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "next build && npm run build:worker",
    "build:worker": "node scripts/build-render-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run src/app/api",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:3000 cypress:run",
    "db:types": "node scripts/gen-db-types.mjs",
    "i18n:keys": "I18N_WRITE_CLIENT_KEYS=1 vitest run src/lib/i18n/client-boundary.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.33.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
