# Copier vers .env.local — valeurs uniquement, jamais de secrets dans git.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INDIE_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_INDIE_YEARLY_PRICE_ID=
STRIPE_STUDIO_YEARLY_PRICE_ID=
# Activer seulement après configuration fiscale et validation de Stripe Tax.
STRIPE_TAX_ENABLED=false
# Production seulement, après achat réel contrôlé.
STRIPE_LIVE_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
RESEND_FROM=DuoShot <noreply@duoshot.site>
RESEND_API_KEY=
# Projet Mixpanel créé en région UE. Le jeton de projet est public et intégré au build.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Jeton OAuth GDPR Mixpanel, côté serveur uniquement, pour les suppressions de compte.
MIXPANEL_GDPR_OAUTH_TOKEN=
# Protège la tâche planifiée de suppression analytique.
CRON_SECRET=

# IDs internes séparés par une virgule ; exclus des rapports commerciaux.
ANALYTICS_INTERNAL_USER_IDS=
GOOGLE_SITE_VERIFICATION=
# VPS CX23 : un rendu lourd actif par processus. Passer à 2 après mesure mémoire.
# Limite provisoire en mémoire ; ne remplace pas une file de travaux durable.
RENDER_CONCURRENCY=1
