# Copier vers .env.local — valeurs uniquement, jamais de secrets dans git.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Serveur uniquement : URL Docker privee. Le navigateur utilise toujours l'URL publique HTTPS.
SUPABASE_INTERNAL_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Obligatoire pour la facturation : production, test ou development.
APP_ENV=
# Limiter la recette live à ces UUID (CSV). Vide = ouverture à tous une fois validée.
BILLING_ALLOWED_USER_IDS=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INDIE_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_INDIE_YEARLY_PRICE_ID=
STRIPE_STUDIO_YEARLY_PRICE_ID=
# Facultatif : prix Stripe unique (mode payment) du « Pass 30 jours » (19 € par défaut,
# montant affiché dans src/lib/plans.ts). Vide = offre masquée partout.
STRIPE_PRICE_PASS30=
# Activer seulement après configuration fiscale et validation de Stripe Tax.
STRIPE_TAX_ENABLED=false
# Production seulement, après achat réel contrôlé.
STRIPE_LIVE_ENABLED=false
STRIPE_CHECKOUT_ENABLED=false
RESEND_FROM=DuoShot <noreply@duoshot.site>
RESEND_API_KEY=
# Mixpanel ne collecte plus rien (DataFast uniquement). Ces deux variables serveur, lues à
# l'exécution, servent seulement à effacer les données historiques du projet Mixpanel UE
# après une suppression de compte (tâche analytics-erasure).
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_GDPR_OAUTH_TOKEN=
# Protège les tâches planifiées (/api/cron/*). 32 caractères minimum : openssl rand -hex 32
CRON_SECRET=
# Protège le worker de rendu interne (/api/internal/render-worker). Valeur distincte de CRON_SECRET.
# Tant qu'elle est vide, le worker retombe sur CRON_SECRET (transition) et journalise un avertissement.
RENDER_WORKER_SECRET=

# IDs internes séparés par une virgule ; exclus des rapports commerciaux.
ANALYTICS_INTERNAL_USER_IDS=
GOOGLE_SITE_VERIFICATION=
# VPS CX23 : un rendu lourd actif par processus. Passer à 2 après mesure mémoire.
# Limite provisoire en mémoire ; ne remplace pas une file de travaux durable.
RENDER_CONCURRENCY=1
# Enable only after migration 20260926190000 and the persistent worker are installed.
RENDER_QUEUE_ENABLED=false
